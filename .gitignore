# --- Data files (too large for GitHub; regenerated by running notebook 01 onward) ---
# The StatsBomb event files alone are well over GitHub's 100 MB per-file limit.
data/raw/*
data/processed/*
# ...but keep the empty folders in the repo so the structure is visible
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Python ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# --- Secrets / local config (never commit these) ---
.env
*.key
*.pem

# --- OS / editor clutter ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- soccerdata's local cache, if it ever lands inside the project folder ---
soccerdata/
